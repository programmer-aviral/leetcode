from typing import List
from math import gcd

class Solution:
    def findKthSmallest(self, coins: List[int], k: int) -> int:
        
        # Remove coins that are multiples of smaller coins
        coins.sort()
        valid = []
        
        for coin in coins:
            if not any(coin % prev == 0 for prev in valid):
                valid.append(coin)
        
        coins = valid
        n = len(coins)

        # Calculate LCM safely
        def lcm(a, b):
            return a // gcd(a, b) * b

        # Count how many numbers <= x are divisible
        # by at least one coin
        def count(x):
            total = 0

            for mask in range(1, 1 << n):
                curr_lcm = 1
                bits = 0

                for i in range(n):
                    if mask & (1 << i):
                        bits += 1
                        curr_lcm = lcm(curr_lcm, coins[i])

                        # No need to continue if LCM > x
                        if curr_lcm > x:
                            break

                else:
                    if bits % 2 == 1:
                        total += x // curr_lcm
                    else:
                        total -= x // curr_lcm

            return total

        # Binary search for kth smallest amount
        left, right = 1, min(coins) * k

        while left < right:
            mid = (left + right) // 2

            if count(mid) >= k:
                right = mid
            else:
                left = mid + 1

        return left
