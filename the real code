import java.util.HashSet;

class Solution {

    public int missingInteger(int[] nums) {

        // Step 1: Find the sum of the longest
        // sequential prefix
        int sum = nums[0];

        for (int i = 1; i < nums.length; i++) {

            if (nums[i] == nums[i - 1] + 1) {
                sum += nums[i];
            } else {
                break;
            }
        }

        // Step 2: Put all numbers into a HashSet
        HashSet<Integer> set = new HashSet<>();

        for (int num : nums) {
            set.add(num);
        }

        // Step 3: Find the smallest missing number
        // greater than or equal to the prefix sum
        int answer = sum;

        while (set.contains(answer)) {
            answer++;
        }

        return answer;
    }
}
