class Solution {

    public boolean winnerSquareGame(int n) {

        // dp[i] = true if the player whose turn it is
        // can win when there are i stones remaining.
        boolean[] dp = new boolean[n + 1];

        // dp[0] = false
        // If there are no stones, the current player cannot move,
        // so the current player loses.

        for (int i = 1; i <= n; i++) {

            // Try every possible square number
            for (int j = 1; j * j <= i; j++) {

                int square = j * j;

                // If after removing square stones,
                // the opponent is in a losing position,
                // then current player can win.
                if (!dp[i - square]) {
                    dp[i] = true;
                    break;
                }
            }
        }

        return dp[n];
    }
}
