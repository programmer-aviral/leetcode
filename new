class Solution {

    static class Node {
        char leftChar;
        char rightChar;

        int prefix;
        int suffix;
        int best;
        int length;

        Node(char leftChar, char rightChar,
             int prefix, int suffix,
             int best, int length) {

            this.leftChar = leftChar;
            this.rightChar = rightChar;
            this.prefix = prefix;
            this.suffix = suffix;
            this.best = best;
            this.length = length;
        }
    }

    Node[] tree;
    char[] s;

    public int[] longestRepeating(
            String s,
            String queryCharacters,
            int[] queryIndices) {

        this.s = s.toCharArray();

        int n = s.length();

        tree = new Node[4 * n];

        // Build segment tree
        build(1, 0, n - 1);

        int[] answer = new int[queryIndices.length];

        // Process queries
        for (int i = 0; i < queryIndices.length; i++) {

            int index = queryIndices[i];

            char newChar = queryCharacters.charAt(i);

            // Change character
            this.s[index] = newChar;

            // Update segment tree
            update(1, 0, n - 1, index);

            // Root contains the longest repeating substring
            answer[i] = tree[1].best;
        }

        return answer;
    }

    // Build segment tree
    private void build(int node, int left, int right) {

        // Leaf node
        if (left == right) {

            tree[node] = new Node(
                    s[left],
                    s[left],
                    1,
                    1,
                    1,
                    1
            );

            return;
        }

        int mid = left + (right - left) / 2;

        build(node * 2, left, mid);

        build(node * 2 + 1, mid + 1, right);

        tree[node] = merge(
                tree[node * 2],
                tree[node * 2 + 1]
        );
    }

    // Update one index
    private void update(int node, int left, int right, int index) {

        // Leaf
        if (left == right) {

            tree[node] = new Node(
                    s[index],
                    s[index],
                    1,
                    1,
                    1,
                    1
            );

            return;
        }

        int mid = left + (right - left) / 2;

        if (index <= mid) {

            update(
                    node * 2,
                    left,
                    mid,
                    index
            );

        } else {

            update(
                    node * 2 + 1,
                    mid + 1,
                    right,
                    index
            );
        }

        // Recalculate current node
        tree[node] = merge(
                tree[node * 2],
                tree[node * 2 + 1]
        );
    }

    // Merge two segments
    private Node merge(Node a, Node b) {

        int prefix = a.prefix;

        int suffix = b.suffix;

        int best = Math.max(a.best, b.best);

        // If the boundary characters are same
        if (a.rightChar == b.leftChar) {

            // Join suffix of left + prefix of right
            best = Math.max(
                    best,
                    a.suffix + b.prefix
            );

            // Entire left segment has same character
            if (a.prefix == a.length) {

                prefix = a.length + b.prefix;
            }

            // Entire right segment has same character
            if (b.suffix == b.length) {

                suffix = b.length + a.suffix;
            }
        }

        return new Node(
                a.leftChar,
                b.rightChar,
                prefix,
                suffix,
                best,
                a.length + b.length
        );
    }
}
